#!/usr/bin/env node
import { HEAVY_WARMUP, VALUES, absent, emit, loadExport, sample } from './harness.mjs';
import { SMALL, allFresh, buildScan, oldEdits, reshapeEdits, warningCount } from './reshape_fixture.mjs';

const REPORT_RESHAPE = 'planReport 220 files reshape plan';

const planReport = await loadExport('src/domain/planned.ts', 'planReport');
const cycleTexts = await loadExport('src/domain/graph.ts', 'cycleTexts');

if (planReport === undefined || cycleTexts === undefined) {
  absent(REPORT_RESHAPE);
} else {
  const scan = buildScan(SMALL);
  const edits = [...oldEdits(SMALL, scan), ...reshapeEdits(SMALL)];
  const report = planReport(scan, edits, cycleTexts);
  allFresh(report.stale, REPORT_RESHAPE);
  const kinds = new Set(report.warnings.flat().map(warning => warning.kind));
  for (const kind of ['empty-package', 'deleted-imports', 'added-cycle']) {
    if (!kinds.has(kind)) throw new Error(`${REPORT_RESHAPE} fixture raised no ${kind} warning`);
  }
  emit(
    REPORT_RESHAPE,
    await sample(() => {
      if (warningCount(planReport(scan, edits, cycleTexts)) !== warningCount(report)) throw new Error(`${REPORT_RESHAPE} changed its warnings`);
    }, VALUES, HEAVY_WARMUP),
  );
}
