const client = await loadModule('src/ui/client.ts');

function hasFn(mod, name) {
  return mod !== undefined && typeof mod[name] === 'function';
}

function fileName(shape, pkg, index) {
  return `pkg${pkg}/f${pkg * shape.perPackage + index}.ts`;
}

function packageFiles(shape, files, edges) {
  for (let i = 0; i < shape.packages; i += 1) {
    for (let j = 0; j < shape.perPackage; j += 1) {
      const from = fileName(shape, i, j);
      files.push({ path: from, test: j % 50 === 0 });
      for (let k = 1; k <= 5; k += 1) {
        const to = k <= 3 ? fileName(shape, i, (j + k * 7) % shape.perPackage) : fileName(shape, (i + k) % shape.packages, (j + k * 3) % shape.perPackage);
        edges.push({ from, to, kind: k === 5 ? 'type' : 'runtime' });
      }
    }
  }
}

function deepFiles(shape, files, edges) {
  for (let j = 0; j < shape.deep; j += 1) {
    const from = `deep/d${j}.ts`;
    files.push({ path: from, test: false });
    for (let k = 1; k <= 5; k += 1) edges.push({ from, to: `deep/d${(j + k * 7) % shape.deep}.ts`, kind: k === 5 ? 'type' : 'runtime' });
  }
}

function buildScan(shape) {
  const files = [];
  const edges = [];
  packageFiles(shape, files, edges);
  deepFiles(shape, files, edges);
  const workspaces = [];
  for (let i = 0; i < WORKSPACES; i += 1) workspaces.push({ dir: `pkg${i}`, name: `@acme/pkg${i}` });
  return { files, edges, externals: [], workspaces };
}

function oldEdits(shape, scan) {
  const cuts = [];
  const seen = new Set();
  for (const edge of scan.edges) {
    if (!edge.from.startsWith('pkg1/') || !edge.to.startsWith('pkg1/')) continue;
    const key = `${edge.from}\n${edge.to}`;
    if (seen.has(key)) continue;
    seen.add(key);
    cuts.push({ kind: 'cut-edge', from: edge.from, to: edge.to, files: [[edge.from, edge.to]] });
    if (cuts.length === 10) break;
  }
  const moves = [];
  for (let i = 1; i <= Math.min(20, shape.perPackage / 2); i += 1) moves.push({ kind: 'move-file', file: fileName(shape, 0, i), to: '.' });
  const half = shape.packages / 2;
  const adds = [];
  for (let i = 0; i < half; i += 1) adds.push({ kind: 'add-edge', from: `pkg${i}`, to: `pkg${(i + half + 1) % shape.packages}` });
  const notes = [];
  for (let i = 0; i < 5; i += 1) notes.push({ kind: 'note', target: { node: `pkg${i + half}` }, text: `note ${i}` });
  for (let i = 0; i < 4; i += 1) notes.push({ kind: 'note', target: { edge: [`pkg${i + half}`, `pkg${(i + half + 4) % shape.packages}`] }, text: `edge ${i}` });
  const clear = edit => !JSON.stringify(edit).includes(`"${SPLIT}"`);
  return [...cuts, ...moves, ...adds.filter(clear), ...notes.filter(clear)];
}

function halves(files) {
  const half = Math.floor(files.length / 2);
  return [
    { name: 'read', files: files.slice(0, half) },
    { name: 'write', files: files.slice(half) },
  ];
}

function packageList(shape, pkg) {
  const files = [];
  for (let j = 0; j < shape.perPackage; j += 1) files.push(fileName(shape, pkg, j));
  return files;
}

function deepList(shape) {
  const files = [];
  for (let j = 0; j < shape.deep; j += 1) files.push(`deep/d${j}.ts`);
  return files;
}

function reshapeEdits(shape) {
  return [
    { kind: 'create-package', path: 'ports' },
    { kind: 'move-file', file: fileName(shape, 2, 1), to: 'ports' },
    { kind: 'rename-package', from: 'pkg3', to: 'adapters' },
    { kind: 'rename-file', from: fileName(shape, 4, 1), to: 'g1.ts' },
    { kind: 'merge-packages', packages: ['pkg5', 'pkg6'], into: 'infra' },
    { kind: 'split-package', package: SPLIT, parts: halves(packageList(shape, 7)) },
    { kind: 'split-package', package: 'deep', parts: halves(deepList(shape)) },
    { kind: 'fate', file: fileName(shape, 8, 1), fate: 'delete' },
    { kind: 'fate', file: fileName(shape, 9, 1), fate: 'fold', into: fileName(shape, 9, 2) },
    { kind: 'create-package', path: 'spare' },
  ];
}

function planDocument(slug, name, edits) {
  return { version: 1, name, slug, createdAt: CREATED_AT, baseCommit: COMMIT, edits, redo: [] };
}

function requireView(view, count, label) {
  if (view === null || view === undefined || view.nodes.length < count) throw new Error(`${label} did not draw`);
  return view;
}

function allFresh(reasons, label) {
  if (reasons.some(reason => reason !== null)) throw new Error(`${label} fixture is stale: ${JSON.stringify(reasons)}`);
}

function warningCount(report) {
  return report.warnings.reduce((sum, list) => sum + list.length, 0);
}

function oldRequest(scan, edits) {
  const planned = applyPlan(scan, edits);
  const stale = staleReasons(scan, edits);
  const view = requireView(graphView(planned, '', ROOT_NAME), 10, REQUEST_005);
  return { ...view, stale };
}

function newRequest(scan, edits, label) {
  const report = planReport(scan, edits, cycleTexts);
  const view = requireView(graphView(report.scan, '', ROOT_NAME), 10, label);
  const body = { ...view, stale: report.stale };
  return report.warnings.every(list => list.length === 0) ? body : { ...body, warnings: report.warnings };
}

async function measureRequest005(scan, edits) {
  if (applyPlan === undefined || staleReasons === undefined || graphView === undefined) {
    absent(REQUEST_005);
    return;
  }
  const request = planReport !== undefined && cycleTexts !== undefined ? () => newRequest(scan, edits, REQUEST_005) : () => oldRequest(scan, edits);
  allFresh(request().stale, REQUEST_005);
  emit(
    REQUEST_005,
    await sample(() => {
      const body = request();
      if (body.stale.length !== edits.length) throw new Error(`${REQUEST_005} dropped an edit`);
    }, VALUES, WARMUP),
  );
}

function firstEdgeFrom(view, id) {
  const edge = view.edges.find(item => item.from === id && view.nodes.some(node => node.id === item.to));
  if (edge === undefined) throw new Error(`no arrow from ${id}`);
  return edge.to;
}

function importersOf(scan, file) {
  return [...new Set(scan.edges.filter(edge => edge.to === file).map(edge => edge.from))].sort();
}

function handWarnings(scan, edits) {
  return edits.map(edit => {
    if (edit.kind === 'fate' && edit.fate === 'delete') return [{ kind: 'deleted-imports', file: edit.file, importers: importersOf(scan, edit.file) }];
    if (edit.kind === 'create-package' && edit.path === 'spare') return [{ kind: 'empty-package', path: edit.path }];
    if (edit.kind === 'split-package') return [{ kind: 'added-cycle', cycle: `${edit.parts[0].name} → ${edit.parts[1].name} → ${edit.parts[0].name}` }];
    return [];
  });
}

function pictureInput(scan, planned, root, edits, stale) {
  const nowRoot = requireView(graphView(scan, '', ROOT_NAME), 20, PICTURE);
  const packages = [];
  for (const node of root.nodes) {
    if (node.kind !== 'package') continue;
    const now = graphView(scan, node.id, ROOT_NAME) ?? { error: 'no such directory' };
    const shown = graphView(planned, node.id, ROOT_NAME) ?? { error: 'no such directory' };
    packages.push({ id: node.id, now, planned: shown });
  }
  return {
    shown: 'planned',
    nodes: root.nodes,
    other: nowRoot,
    pins: {},
    edits,
    stale,
    edges: root.edges,
    ids: new Set(root.nodes.map(node => node.id)),
    packages,
    warnings: handWarnings(scan, edits),
  };
}

async function measurePicture(scan, planned, root, edits, stale) {
  if (!hasFn(pictureMod, 'planPicture')) {
    absent(PICTURE);
    return;
  }
  const input = pictureInput(scan, planned, root, edits, stale);
  const warned = input.warnings.flat().length;
  emit(
    PICTURE,
    await sample(() => {
      const picture = pictureMod.planPicture(input);
      if (picture.entries.length !== edits.length) throw new Error(`${PICTURE} dropped an entry`);
      if (picture.entries.reduce((sum, entry) => sum + entry.warnings.length, 0) !== warned) throw new Error(`${PICTURE} dropped a warning`);
      for (const edit of edits) pictureMod.entryTarget(edit);
    }, VALUES, WARMUP),
  );
}

async function measureReports(scan, edits005, edits) {
  const report = planReport(scan, edits, cycleTexts);
  allFresh(report.stale, REPORT_RESHAPE);
  const kinds = new Set(report.warnings.flat().map(warning => warning.kind));
  for (const kind of ['empty-package', 'deleted-imports', 'added-cycle']) {
    if (!kinds.has(kind)) throw new Error(`${REPORT_RESHAPE} fixture raised no ${kind} warning`);
  }
  allFresh(planReport(scan, edits005, cycleTexts).stale, REPORT_005);

  emit(
    REPORT_005,
    await sample(() => {
      if (planReport(scan, edits005, cycleTexts).stale.length !== edits005.length) throw new Error(`${REPORT_005} dropped an edit`);
    }, VALUES, WARMUP),
  );

  emit(
    REPORT_RESHAPE,
    await sample(() => {
      const next = planReport(scan, edits, cycleTexts);
      if (warningCount(next) !== warningCount(report)) throw new Error(`${REPORT_RESHAPE} changed its warnings`);
    }, VALUES, WARMUP),
  );

  emit(
    REQUEST_RESHAPE,
    await sample(() => {
      if (newRequest(scan, edits, REQUEST_RESHAPE).warnings === undefined) throw new Error(`${REQUEST_RESHAPE} lost its warnings`);
    }, VALUES, WARMUP),
  );

  emit(
    CYCLES,
    await sample(() => {
      if (cycleTexts(scan).length === 0) throw new Error(`${CYCLES} found no cycle`);
    }, VALUES, WARMUP),
  );
}

async function measureViews(scan, edits) {
  const stale = staleReasons(scan, edits);
  allFresh(stale, APPLY);
  const planned = applyPlan(scan, edits);
  if ((planned.hidden ?? []).length === 0 || (planned.deleted ?? []).length === 0) throw new Error(`${APPLY} did not hide or delete`);

  emit(
    APPLY,
    await sample(() => {
      const next = applyPlan(scan, edits);
      if (next.files.length !== scan.files.length - 1) throw new Error(`${APPLY} lost the fold`);
    }, VALUES, WARMUP),
  );

  const root = requireView(graphView(planned, '', ROOT_NAME), 20, GRAPH_ROOT);
  for (const id of ['infra', 'adapters', 'ports', 'spare', 'pkg7/read', 'deep/read']) {
    if (!root.nodes.some(node => node.id === id)) throw new Error(`${GRAPH_ROOT} did not draw ${id}`);
  }
  emit(
    GRAPH_ROOT,
    await sample(() => {
      requireView(graphView(planned, '', ROOT_NAME), 20, GRAPH_ROOT);
    }, VALUES, WARMUP),
  );

  emit(
    GRAPH_DEEP,
    await sample(() => {
      requireView(graphView(planned, 'deep/read', ROOT_NAME), 40, GRAPH_DEEP);
    }, VALUES, WARMUP),
  );

  const fateView = requireView(graphView(planned, 'pkg8', ROOT_NAME), 150, GRAPH_FATE);
  if (!fateView.nodes.some(node => node.fate === 'delete')) throw new Error(`${GRAPH_FATE} drew no deleted file`);
  emit(
    GRAPH_FATE,
    await sample(() => {
      requireView(graphView(planned, 'pkg8', ROOT_NAME), 150, GRAPH_FATE);
    }, VALUES, WARMUP),
  );

  emit(
    DETAIL,
    await sample(() => {
      if (nodeDetail(planned, 'infra', '', ROOT_NAME) === null) throw new Error(`${DETAIL} found no infra`);
    }, VALUES, WARMUP),
  );

  const pairTo = firstEdgeFrom(root, 'infra');
  emit(
    PAIRS,
    await sample(() => {
      if (edgePairs(planned, '', 'infra', pairTo).length === 0) throw new Error(`${PAIRS} found no imports`);
    }, VALUES, WARMUP),
  );

  await measurePicture(scan, planned, root, edits, stale);
  await measureParse(edits);
}

async function measureParse(edits) {
  if (!hasFn(planMod, 'parsePlan')) {
    absent(PARSE);
    return;
  }
  const raw = planDocument('reshape', 'Reshape', edits);
  if (planMod.parsePlan(raw) === undefined) throw new Error(`${PARSE} rejected the document`);
  emit(
    PARSE,
    await sample(() => {
      const parsed = planMod.parsePlan(raw);
      if (parsed === undefined || parsed.edits.length !== edits.length) throw new Error(`${PARSE} rejected the document`);
      let text = 0;
      for (const edit of parsed.edits) text += planMod.sentenceOf(edit).length;
      if (text === 0) throw new Error(`${PARSE} sentence`);
    }, VALUES, WARMUP),
  );
}

async function measureDialog() {
  if (!hasFn(reshapeMod, 'nameEdit') || !hasFn(reshapeMod, 'splitEdit')) {
    absent(DIALOG);
    return;
  }
  const files = packageList(BIG, 7);
  const taken = new Set(files);
  for (let i = 0; i < BIG.packages; i += 1) taken.add(`pkg${i}`);
  const assigned = {};
  files.forEach((file, index) => {
    assigned[file] = index < BIG.perPackage / 2 ? 'read' : 'write';
  });
  const scene = { at: '', taken, selected: [{ id: 'pkg5', name: 'pkg5' }, { id: 'pkg6', name: 'pkg6' }] };
  const form = { pkg: 'pkg7', names: ['read', 'write', ''], files, assigned, taken: new Set(taken) };
  emit(
    DIALOG,
    await sample(() => {
      const outcomes = [
        reshapeMod.nameEdit({ mode: 'create' }, 'ports', scene),
        reshapeMod.nameEdit({ mode: 'rename', id: 'pkg3', kind: 'package' }, 'adapters', scene),
        reshapeMod.nameEdit({ mode: 'rename', id: fileName(BIG, 4, 0), kind: 'file' }, 'g800', scene),
        reshapeMod.nameEdit({ mode: 'merge' }, 'infra', scene),
        reshapeMod.splitEdit(form),
      ];
      if (outcomes.some(outcome => !('edit' in outcome) || outcome.edit === null)) throw new Error(`${DIALOG} refused: ${JSON.stringify(outcomes.map(o => o.problem))}`);
      if (reshapeMod.splitRows('pkg7', files).length !== files.length) throw new Error(`${DIALOG} dropped a row`);
    }, VALUES, WARMUP),
  );
}

function warnedGraphBody() {
  const nodes = [];
  const edges = [];
  for (let i = 0; i < 500; i += 1) {
    const node = { id: `pkg${i}/f${i}.ts`, kind: 'file', name: `f${i}.ts`, path: `pkg${i}/f${i}.ts`, row: 0, order: i, cycle: false };
    nodes.push(i % 10 === 0 ? { ...node, fate: 'delete' } : node);
    if (i === 0) continue;
    const edge = { from: `pkg${i - 1}/f${i - 1}.ts`, to: `pkg${i}/f${i}.ts`, runtime: 1, type: 0, cycle: i % 17 === 0 };
    edges.push(i % 5 === 0 ? { ...edge, planned: true } : edge);
  }
  const stale = [];
  const warnings = [];
  for (let i = 0; i < 50; i += 1) {
    stale.push(null);
    const importers = [];
    for (let j = 0; j < 20; j += 1) importers.push(`pkg${j}/f${j}.ts`);
    if (i % 3 === 0) warnings.push([{ kind: 'deleted-imports', file: `pkg${i}/f${i}.ts`, importers }]);
    else if (i % 3 === 1) warnings.push([{ kind: 'empty-package', path: `pkg${i}/part` }]);
    else warnings.push([{ kind: 'added-cycle', cycle: `pkg${i} → pkg${i + 1} → pkg${i}` }]);
  }
  return { at: 'pkg0', crumbs: [{ name: ROOT_NAME, at: '' }], nodes, edges, crapMax: 4, coverage: 'off', mutation: 'off', stale, warnings };
}

async function measureFetch() {
  if (!hasFn(client, 'fetchGraph')) {
    absent(FETCH);
    return;
  }
  const body = warnedGraphBody();
  const fetcher = async () => ({ ok: true, json: async () => body });
  const trial = await client.fetchGraph('token', 'pkg0', fetcher, { plan: 'reshape' });
  if (trial === null || typeof trial !== 'object' || 'error' in trial) {
    absent(FETCH);
    return;
  }
  const warned = trial.warnings !== undefined;
  emit(
    FETCH,
    await sample(async () => {
      const parsed = await client.fetchGraph('token', 'pkg0', fetcher, { plan: 'reshape' });
      if ('error' in parsed || parsed.nodes.length !== 500) throw new Error(`${FETCH} rejected the body`);
      if (warned && parsed.warnings.length !== 50) throw new Error(`${FETCH} dropped a warning`);
    }, VALUES, WARMUP),
  );
}

function httpSource(pkg, index) {
  const lines = [];
  for (let k = 1; k <= 3; k += 1) lines.push(`import { v${k} } from './f${pkg * HTTP_PER_PACKAGE + ((index + k * 7) % HTTP_PER_PACKAGE)}';`);
  for (const step of [1, 3]) {
    const other = (pkg + step) % HTTP_PACKAGES;
    lines.push(`import { w${step} } from '../p${other}/f${other * HTTP_PER_PACKAGE + ((index + step) % HTTP_PER_PACKAGE)}';`);
  }
  lines.push('export const v1 = 1;', 'export const v2 = 2;', 'export const v3 = 3;', 'export const w1 = 1;', 'export const w3 = 3;');
  return `${lines.join('\n')}\n`;
}

function httpFile(pkg, index) {
  return `src/p${pkg}/f${pkg * HTTP_PER_PACKAGE + index}.ts`;
}

async function httpRepo() {
  const root = await mkdtemp(join(tmpdir(), 'bw-perf-reshape-'));
  const writes = [];
  for (let i = 0; i < HTTP_PACKAGES; i += 1) {
    for (let j = 0; j < HTTP_PER_PACKAGE; j += 1) {
      const path = join(root, ...httpFile(i, j).split('/'));
      writes.push(mkdir(dirname(path), { recursive: true }).then(() => writeFile(path, httpSource(i, j))));
    }
  }
  await Promise.all(writes);
  await writeFile(join(root, 'README.md'), '# reshape\n');
  await gitFixture(root);
  return root;
}

function httpMoves() {
  const edits = [];
  for (let j = 1; j <= 5; j += 1) edits.push({ kind: 'move-file', file: httpFile(0, j), to: 'src/p1' });
  edits.push({ kind: 'add-edge', from: 'src/p2', to: 'src/p6' });
  edits.push({ kind: 'note', target: { node: 'src/p2' }, text: 'seam' });
  return edits;
}

function httpReshape() {
  const p3 = [];
  for (let j = 0; j < HTTP_PER_PACKAGE; j += 1) p3.push(httpFile(3, j));
  return [
    { kind: 'create-package', path: 'src/ports' },
    { kind: 'move-file', file: httpFile(0, 0), to: 'src/ports' },
    { kind: 'rename-package', from: 'src/p1', to: 'src/adapters' },
    { kind: 'rename-file', from: httpFile(2, 0), to: 'g100.ts' },
    { kind: 'split-package', package: 'src/p3', parts: halves(p3) },
    { kind: 'merge-packages', packages: ['src/p4', 'src/p5'], into: 'src/infra' },
    { kind: 'fate', file: httpFile(6, 0), fate: 'delete' },
    { kind: 'fate', file: httpFile(7, 0), fate: 'fold', into: httpFile(7, 1) },
    { kind: 'create-package', path: 'src/spare' },
  ];
}

function readJson(res) {
  return JSON.parse(res.body.toString('utf8'));
}

async function storePlan(call, name, edits) {
  const created = await call('POST', '/api/plans', JSON.stringify({ name }));
  if (created.status !== 201) throw new Error(`POST /api/plans ${name} -> ${created.status} ${created.body.toString('utf8')}`);
  const doc = { ...readJson(created), edits, redo: [] };
  const body = JSON.stringify(doc);
  const stored = await call('PUT', `/api/plans/${doc.slug}`, body);
  return { slug: doc.slug, body, ok: stored.status === 200 };
}

function getter(call, label, path, check = () => true) {
  return async () => {
    const res = await call('GET', path);
    if (res.status !== 200 || !check(res)) throw new Error(`${label} -> ${res.status} ${res.body.toString('utf8').slice(0, 200)}`);
  };
}

async function measureMoves(call) {
  const moves = await storePlan(call, 'Moves', httpMoves());
  if (!moves.ok) throw new Error('PUT /api/plans/moves refused the 005 plan');
  const freshCheck = res => readJson(res).stale.every(reason => reason === null);
  const graph = getter(call, HTTP_MOVES[0], `/api/graph?plan=${moves.slug}`, freshCheck);
  const graphAt = getter(call, HTTP_MOVES[1], `/api/graph?at=src&plan=${moves.slug}`, freshCheck);
  await graph();
  await graphAt();
  emit(HTTP_MOVES[0], await sample(graph, VALUES, WARMUP));
  emit(HTTP_MOVES[1], await sample(graphAt, VALUES, WARMUP));
}

async function measureReshapeHttp(call) {
  const reshape = await storePlan(call, 'Reshape', httpReshape());
  if (!reshape.ok) {
    absent(...HTTP_RESHAPE);
    return;
  }
  const warnedCheck = res => {
    const body = readJson(res);
    return body.stale.every(reason => reason === null) && Array.isArray(body.warnings);
  };
  const graph = getter(call, HTTP_RESHAPE[0], `/api/graph?plan=${reshape.slug}`, warnedCheck);
  const graphAt = getter(call, HTTP_RESHAPE[1], `/api/graph?at=src&plan=${reshape.slug}`, warnedCheck);
  await graph();
  await graphAt();
  const atSrc = readJson(await call('GET', `/api/graph?at=src&plan=${reshape.slug}`));
  for (const id of ['src/infra', 'src/adapters', 'src/ports', 'src/spare', 'src/p3/read']) {
    if (!atSrc.nodes.some(node => node.id === id)) throw new Error(`${HTTP_RESHAPE[1]} did not draw ${id}`);
  }
  const pairTo = firstEdgeFrom(atSrc, 'src/infra');
  const detail = getter(call, HTTP_RESHAPE[2], `/api/detail?id=src/infra&at=src&plan=${reshape.slug}`);
  const pairs = getter(call, HTTP_RESHAPE[3], `/api/pairs?from=src/infra&to=${pairTo}&at=src&plan=${reshape.slug}`, res => readJson(res).pairs.length > 0);
  async function put() {
    const res = await call('PUT', `/api/plans/${reshape.slug}`, reshape.body);
    if (res.status !== 200) throw new Error(`${HTTP_RESHAPE[4]} -> ${res.status}`);
  }
  emit(HTTP_RESHAPE[0], await sample(graph, VALUES, WARMUP));
  emit(HTTP_RESHAPE[1], await sample(graphAt, VALUES, WARMUP));
  emit(HTTP_RESHAPE[2], await sample(detail, VALUES, WARMUP));
  emit(HTTP_RESHAPE[3], await sample(pairs, VALUES, WARMUP));
  emit(HTTP_RESHAPE[4], await sample(put, VALUES, WARMUP));
}

async function measureHttp() {
  const serve = await loadModule('src/serve.ts');
  if (serve === undefined || typeof serve.bindApp !== 'function') {
    absent(...HTTP_MOVES, ...HTTP_RESHAPE);
    return;
  }
  const prepareBindweed = await loadExport('src/repo.ts', 'prepareBindweed');
  const repo = await httpRepo();
  const ui = await fixtureUi();
  const agent = keepAliveAgent();
  let server;
  try {
    if (prepareBindweed !== undefined) await prepareBindweed(repo);
    const bound = await serve.bindApp({ repoRoot: repo, uiDir: ui }, { mode: 'fixed', port: 0 });
    if ('error' in bound) throw new Error(`bindApp failed: ${JSON.stringify(bound.error)}`);
    server = bound.server;
    const addr = server.address();
    if (addr === null || typeof addr === 'string') throw new Error('no port');
    const auth = { Authorization: `Bearer ${bound.token}` };
    const call = (method, path, body = null) => hit(agent, addr.port, method, path, auth, body);
    const probe = await call('GET', '/api/plans');
    if (probe.status !== 200) {
      absent(...HTTP_MOVES, ...HTTP_RESHAPE);
      return;
    }
    await measureMoves(call);
    await measureReshapeHttp(call);
  } finally {
    agent.destroy();
    if (server) await new Promise(resolve => server.close(() => resolve()));
    await cleanup(repo, ui);
  }
}

