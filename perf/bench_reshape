#!/usr/bin/env node
import {
  VALUES,
  WARMUP,
  absent,
  emit,
  loadExport,
  sample,
} from './harness.mjs';

const SMALL = { packages: 10, perPackage: 20, deep: 20 };
const SPLIT = 'pkg7';
const ROOT_NAME = 'perf-repo';

const REQUEST_005 = 'planned graph request 220 files 005 plan';
const REQUEST_RESHAPE = 'planned graph request 220 files reshape plan';
const REPORT_005 = 'planReport 220 files 005 plan';
const REPORT_RESHAPE = 'planReport 220 files reshape plan';
const CYCLES = 'cycleTexts 220 files';

const TARGETS = [REQUEST_005, REPORT_005, REPORT_RESHAPE, REQUEST_RESHAPE, CYCLES];

const applyPlan = await loadExport('src/domain/planned.ts', 'applyPlan');
const staleReasons = await loadExport('src/domain/planned.ts', 'staleReasons');
const planReport = await loadExport('src/domain/planned.ts', 'planReport');
const graphView = await loadExport('src/domain/graph.ts', 'graphView');
const cycleTexts = await loadExport('src/domain/graph.ts', 'cycleTexts');

function fileName(shape, pkg, index) {
  return `pkg${pkg}/f${pkg * shape.perPackage + index}.ts`;
}

function packageFiles(shape, files, edges) {
  for (let i = 0; i < shape.packages; i += 1) {
    for (let j = 0; j < shape.perPackage; j += 1) {
      const from = fileName(shape, i, j);
      files.push({ path: from, test: j % 50 === 0 });
      for (let k = 1; k <= 5; k += 1) {
        const to =
          k <= 3
            ? fileName(shape, i, (j + k * 7) % shape.perPackage)
            : fileName(shape, (i + k) % shape.packages, (j + k * 3) % shape.perPackage);
        edges.push({ from, to, kind: k === 5 ? 'type' : 'runtime' });
      }
    }
  }
}

function deepFiles(shape, files, edges) {
  for (let j = 0; j < shape.deep; j += 1) {
    const from = `deep/d${j}.ts`;
    files.push({ path: from, test: false });
    for (let k = 1; k <= 5; k += 1) {
      edges.push({ from, to: `deep/d${(j + k * 7) % shape.deep}.ts`, kind: k === 5 ? 'type' : 'runtime' });
    }
  }
}

function buildScan(shape) {
  const files = [];
  const edges = [];
  packageFiles(shape, files, edges);
  deepFiles(shape, files, edges);
  const workspaces = [];
  for (let i = 0; i < 8; i += 1) workspaces.push({ dir: `pkg${i}`, name: `@acme/pkg${i}` });
  return { files, edges, externals: [], workspaces };
}

function oldEdits(shape, scan) {
  const cuts = [];
  const seen = new Set();
  for (const edge of scan.edges) {
    if (!edge.from.startsWith('pkg1/') || !edge.to.startsWith('pkg1/')) continue;
    const key = `${edge.from}\n${edge.to}`;
    if (seen.has(key)) continue;
    seen.add(key);
    cuts.push({ kind: 'cut-edge', from: edge.from, to: edge.to, files: [[edge.from, edge.to]] });
    if (cuts.length === 10) break;
  }
  const moves = [];
  for (let i = 1; i <= Math.min(20, shape.perPackage / 2); i += 1) moves.push({ kind: 'move-file', file: fileName(shape, 0, i), to: '.' });
  const half = shape.packages / 2;
  const adds = [];
  for (let i = 0; i < half; i += 1) adds.push({ kind: 'add-edge', from: `pkg${i}`, to: `pkg${(i + half + 1) % shape.packages}` });
  const notes = [];
  for (let i = 0; i < 5; i += 1) notes.push({ kind: 'note', target: { node: `pkg${i + half}` }, text: `note ${i}` });
  for (let i = 0; i < 4; i += 1) notes.push({ kind: 'note', target: { edge: [`pkg${i + half}`, `pkg${(i + half + 4) % shape.packages}`] }, text: `edge ${i}` });
  const clear = edit => !JSON.stringify(edit).includes(`"${SPLIT}"`);
  return [...cuts, ...moves, ...adds.filter(clear), ...notes.filter(clear)];
}

function halves(files) {
  const half = Math.floor(files.length / 2);
  return [
    { name: 'read', files: files.slice(0, half) },
    { name: 'write', files: files.slice(half) },
  ];
}

function packageList(shape, pkg) {
  const files = [];
  for (let j = 0; j < shape.perPackage; j += 1) files.push(fileName(shape, pkg, j));
  return files;
}

function deepList(shape) {
  const files = [];
  for (let j = 0; j < shape.deep; j += 1) files.push(`deep/d${j}.ts`);
  return files;
}

function reshapeEdits(shape) {
  return [
    { kind: 'create-package', path: 'ports' },
    { kind: 'move-file', file: fileName(shape, 2, 1), to: 'ports' },
    { kind: 'rename-package', from: 'pkg3', to: 'adapters' },
    { kind: 'rename-file', from: fileName(shape, 4, 1), to: 'g1.ts' },
    { kind: 'merge-packages', packages: ['pkg5', 'pkg6'], into: 'infra' },
    { kind: 'split-package', package: SPLIT, parts: halves(packageList(shape, 7)) },
    { kind: 'split-package', package: 'deep', parts: halves(deepList(shape)) },
    { kind: 'fate', file: fileName(shape, 8, 1), fate: 'delete' },
    { kind: 'fate', file: fileName(shape, 9, 1), fate: 'fold', into: fileName(shape, 9, 2) },
    { kind: 'create-package', path: 'spare' },
  ];
}

function requireView(view, count, label) {
  if (view === null || view === undefined || view.nodes.length < count) throw new Error(`${label} did not draw`);
  return view;
}

function allFresh(reasons, label) {
  if (reasons.some(reason => reason !== null)) throw new Error(`${label} fixture is stale: ${JSON.stringify(reasons)}`);
}

function warningCount(report) {
  return report.warnings.reduce((sum, list) => sum + list.length, 0);
}

function oldRequest(scan, edits) {
  const planned = applyPlan(scan, edits);
  const stale = staleReasons(scan, edits);
  const view = requireView(graphView(planned, '', ROOT_NAME), 10, REQUEST_005);
  return { ...view, stale };
}

function newRequest(scan, edits, label) {
  const report = planReport(scan, edits, cycleTexts);
  const view = requireView(graphView(report.scan, '', ROOT_NAME), 10, label);
  const body = { ...view, stale: report.stale };
  return report.warnings.every(list => list.length === 0) ? body : { ...body, warnings: report.warnings };
}

async function measureRequest005(scan, edits) {
  if (applyPlan === undefined || staleReasons === undefined || graphView === undefined) {
    absent(REQUEST_005);
    return;
  }
  const request = planReport !== undefined && cycleTexts !== undefined ? () => newRequest(scan, edits, REQUEST_005) : () => oldRequest(scan, edits);
  allFresh(request().stale, REQUEST_005);
  emit(
    REQUEST_005,
    await sample(() => {
      const body = request();
      if (body.stale.length !== edits.length) throw new Error(`${REQUEST_005} dropped an edit`);
    }, VALUES, WARMUP),
  );
}

async function measureReports(scan, edits005, edits) {
  const report = planReport(scan, edits, cycleTexts);
  allFresh(report.stale, REPORT_RESHAPE);
  const kinds = new Set(report.warnings.flat().map(warning => warning.kind));
  for (const kind of ['empty-package', 'deleted-imports', 'added-cycle']) {
    if (!kinds.has(kind)) throw new Error(`${REPORT_RESHAPE} fixture raised no ${kind} warning`);
  }
  allFresh(planReport(scan, edits005, cycleTexts).stale, REPORT_005);

  emit(
    REPORT_005,
    await sample(() => {
      if (planReport(scan, edits005, cycleTexts).stale.length !== edits005.length) throw new Error(`${REPORT_005} dropped an edit`);
    }, VALUES, WARMUP),
  );

  emit(
    REPORT_RESHAPE,
    await sample(() => {
      const next = planReport(scan, edits, cycleTexts);
      if (warningCount(next) !== warningCount(report)) throw new Error(`${REPORT_RESHAPE} changed its warnings`);
    }, VALUES, WARMUP),
  );

  emit(
    REQUEST_RESHAPE,
    await sample(() => {
      if (newRequest(scan, edits, REQUEST_RESHAPE).warnings === undefined) throw new Error(`${REQUEST_RESHAPE} lost its warnings`);
    }, VALUES, WARMUP),
  );

  emit(
    CYCLES,
    await sample(() => {
      if (cycleTexts(scan).length === 0) throw new Error(`${CYCLES} found no cycle`);
    }, VALUES, WARMUP),
  );
}

const small = buildScan(SMALL);
const small005 = oldEdits(SMALL, small);
await measureRequest005(small, small005);
if (planReport === undefined || cycleTexts === undefined || graphView === undefined) {
  absent(REPORT_005, REPORT_RESHAPE, REQUEST_RESHAPE, CYCLES);
} else {
  await measureReports(small, small005, [...small005, ...reshapeEdits(SMALL)]);
}
