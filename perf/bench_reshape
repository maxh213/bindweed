const BIG = { packages: 20, perPackage: 200, deep: 100 };
const SMALL = { packages: 10, perPackage: 20, deep: 20 };
const SPLIT = 'pkg7';
const WORKSPACES = 8;
const ROOT_NAME = 'perf-repo';

const HTTP_PACKAGES = 8;
const HTTP_PER_PACKAGE = 50;

const REQUEST_005 = 'planned graph request 220 files 005 plan';
const REQUEST_RESHAPE = 'planned graph request 220 files reshape plan';
const REPORT_005 = 'planReport 220 files 005 plan';
const REPORT_RESHAPE = 'planReport 220 files reshape plan';
const CYCLES = 'cycleTexts 220 files';
const APPLY = 'applyPlan 4100 files reshape plan';
const GRAPH_ROOT = 'graphView root 4100 files reshaped';
const GRAPH_DEEP = 'graphView deep/read 50 files reshaped';
const GRAPH_FATE = 'graphView pkg8 200 files reshaped';
const DETAIL = 'nodeDetail root 4100 files reshaped';
const PAIRS = 'edgePairs 4100 files reshaped';
const PICTURE = 'planPicture 4100 files reshaped';
const PARSE = 'parsePlan 50 reshape edits';
const DIALOG = 'reshape dialog rules 200 files';
const FETCH = 'fetchGraph planned with warnings 500 nodes';

const SCAN_TARGETS = [REPORT_005, REPORT_RESHAPE, REQUEST_RESHAPE, CYCLES, APPLY, GRAPH_ROOT, GRAPH_DEEP, GRAPH_FATE, DETAIL, PAIRS, PICTURE];

const HTTP_MOVES = ['GET /api/graph?plan=moves 400 files', 'GET /api/graph?at=src&plan=moves 400 files'];
const HTTP_RESHAPE = [
  'GET /api/graph?plan=reshape 400 files',
  'GET /api/graph?at=src&plan=reshape 400 files',
  'GET /api/detail?plan=reshape 400 files',
  'GET /api/pairs?plan=reshape 400 files',
  'PUT /api/plans/reshape',
];

const CREATED_AT = '2026-10-09T12:00:00.000Z';
const COMMIT = 'ab'.repeat(20);

const applyPlan = await loadExport('src/domain/planned.ts', 'applyPlan');
const staleReasons = await loadExport('src/domain/planned.ts', 'staleReasons');
const planReport = await loadExport('src/domain/planned.ts', 'planReport');
const graphView = await loadExport('src/domain/graph.ts', 'graphView');
const nodeDetail = await loadExport('src/domain/graph.ts', 'nodeDetail');
const edgePairs = await loadExport('src/domain/graph.ts', 'edgePairs');
const cycleTexts = await loadExport('src/domain/graph.ts', 'cycleTexts');
const planMod = await loadModule('src/domain/plan.ts');
const pictureMod = await loadModule('src/ui/planpicture.ts');
