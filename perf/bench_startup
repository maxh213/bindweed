#!/usr/bin/env node
import { absent, cleanup, emitOnce, fixtureRepo, fixtureUi, loadModule, timeMs } from './harness.mjs';

const TARGET = 'app listen';

const serve = await loadModule('src/serve.ts');
if (serve === undefined || typeof serve.bindApp !== 'function') {
  absent(TARGET);
  process.exit(0);
}

const repo = await fixtureRepo(20);
const ui = await fixtureUi();

async function oneListen() {
  let bound;
  const ms = await timeMs(async () => {
    bound = await serve.bindApp({ repoRoot: repo, uiDir: ui }, { mode: 'fixed', port: 0 });
    if ('error' in bound) throw new Error(`bindApp failed: ${JSON.stringify(bound.error)}`);
  });
  if (bound !== undefined) await new Promise(resolve => bound.server.close(() => resolve()));
  return ms;
}

try {
  for (let i = 0; i < 3; i += 1) await oneListen();
  emitOnce(TARGET, await oneListen());
} finally {
  await cleanup(repo, ui);
}
