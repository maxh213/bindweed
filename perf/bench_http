#!/usr/bin/env node
import {
  VALUES,
  WARMUP,
  absent,
  cleanup,
  emit,
  emitOnce,
  fixtureRepo,
  fixtureUi,
  hit,
  keepAliveAgent,
  loadExport,
  loadModule,
  sample,
  timeMs,
} from './harness.mjs';

const TARGETS = ['GET /', 'GET /assets/app.js', 'GET /api/tree', 'GET /api/file'];
const GRAPH_TARGETS = ['GET /api/graph', 'GET /api/graph?at=src', 'POST /api/rescan'];
const FIRST_GRAPH = 'GET /api/graph (first request)';

const serve = await loadModule('src/serve.ts');
if (serve === undefined || typeof serve.bindApp !== 'function') {
  absent(...TARGETS, ...GRAPH_TARGETS, FIRST_GRAPH);
  process.exit(0);
}

const prepareBindweed = await loadExport('src/repo.ts', 'prepareBindweed');

const repo = await fixtureRepo(60);
const ui = await fixtureUi();
const agent = keepAliveAgent();
let server;

try {
  if (prepareBindweed !== undefined) await prepareBindweed(repo);
  const bound = await serve.bindApp({ repoRoot: repo, uiDir: ui }, { mode: 'fixed', port: 0 });
  if ('error' in bound) throw new Error(`bindApp failed: ${JSON.stringify(bound.error)}`);
  server = bound.server;
  const addr = server.address();
  if (addr === null || typeof addr === 'string') throw new Error('no port');
  const port = addr.port;
  const auth = { Authorization: `Bearer ${bound.token}` };

  async function getIndex() {
    const res = await hit(agent, port, 'GET', `/?token=${bound.token}`);
    if (res.status !== 200) throw new Error(`GET / -> ${res.status}`);
  }

  async function getAsset() {
    const res = await hit(agent, port, 'GET', '/assets/app.js');
    if (res.status !== 200) throw new Error(`GET /assets/app.js -> ${res.status}`);
  }

  async function getTree() {
    const res = await hit(agent, port, 'GET', '/api/tree', auth);
    if (res.status !== 200) throw new Error(`GET /api/tree -> ${res.status}`);
  }

  async function getFile() {
    const res = await hit(agent, port, 'GET', '/api/file?path=src/a.ts', auth);
    if (res.status !== 200) throw new Error(`GET /api/file -> ${res.status}`);
  }

  async function getGraph() {
    const res = await hit(agent, port, 'GET', '/api/graph', auth);
    if (res.status !== 200) throw new Error(`GET /api/graph -> ${res.status}`);
  }

  async function getGraphDeep() {
    const res = await hit(agent, port, 'GET', '/api/graph?at=src', auth);
    if (res.status !== 200) throw new Error(`GET /api/graph?at=src -> ${res.status}`);
  }

  async function postRescan() {
    const res = await hit(agent, port, 'POST', '/api/rescan', auth);
    if (res.status !== 200) throw new Error(`POST /api/rescan -> ${res.status}`);
  }

  emit('GET /', await sample(getIndex, VALUES, WARMUP));
  emit('GET /assets/app.js', await sample(getAsset, VALUES, WARMUP));
  emit('GET /api/tree', await sample(getTree, VALUES, WARMUP));
  emit('GET /api/file', await sample(getFile, VALUES, WARMUP));

  let firstStatus = 0;
  const firstMs = await timeMs(async () => {
    firstStatus = (await hit(agent, port, 'GET', '/api/graph', auth)).status;
  });
  if (firstStatus === 404) absent(FIRST_GRAPH);
  else if (firstStatus === 200) emitOnce(FIRST_GRAPH, firstMs);
  else throw new Error(`${FIRST_GRAPH} -> ${firstStatus}`);

  const probes = [
    [GRAPH_TARGETS[0], await hit(agent, port, 'GET', '/api/graph', auth), getGraph],
    [GRAPH_TARGETS[1], await hit(agent, port, 'GET', '/api/graph?at=src', auth), getGraphDeep],
    [GRAPH_TARGETS[2], await hit(agent, port, 'POST', '/api/rescan', auth), postRescan],
  ];
  for (const [target, probe, run] of probes) {
    if (probe.status === 404) {
      absent(target);
      continue;
    }
    if (probe.status !== 200) throw new Error(`${target} -> ${probe.status}`);
    emit(target, await sample(run, VALUES, WARMUP));
  }
} finally {
  agent.destroy();
  if (server) await new Promise(resolve => server.close(() => resolve()));
  await cleanup(repo, ui);
}
