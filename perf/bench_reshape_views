#!/usr/bin/env node
import {
  VALUES,
  WARMUP,
  absent,
  emit,
  loadExport,
  loadModule,
  sample,
} from './harness.mjs';

const BIG = { packages: 20, perPackage: 200, deep: 100 };
const SPLIT = 'pkg7';
const ROOT_NAME = 'perf-repo';

const APPLY = 'applyPlan 4100 files reshape plan';
const GRAPH_ROOT = 'graphView root 4100 files reshaped';
const GRAPH_DEEP = 'graphView deep/read 50 files reshaped';
const GRAPH_FATE = 'graphView pkg8 200 files reshaped';
const DETAIL = 'nodeDetail root 4100 files reshaped';
const PAIRS = 'edgePairs 4100 files reshaped';
const PICTURE = 'planPicture 4100 files reshaped';

const TARGETS = [APPLY, GRAPH_ROOT, GRAPH_DEEP, GRAPH_FATE, DETAIL, PAIRS, PICTURE];

const applyPlan = await loadExport('src/domain/planned.ts', 'applyPlan');
const staleReasons = await loadExport('src/domain/planned.ts', 'staleReasons');
const graphView = await loadExport('src/domain/graph.ts', 'graphView');
const nodeDetail = await loadExport('src/domain/graph.ts', 'nodeDetail');
const edgePairs = await loadExport('src/domain/graph.ts', 'edgePairs');
const pictureMod = await loadModule('src/ui/planpicture.ts');

function hasFn(mod, name) {
  return mod !== undefined && typeof mod[name] === 'function';
}

function fileName(shape, pkg, index) {
  return `pkg${pkg}/f${pkg * shape.perPackage + index}.ts`;
}

function packageFiles(shape, files, edges) {
  for (let i = 0; i < shape.packages; i += 1) {
    for (let j = 0; j < shape.perPackage; j += 1) {
      const from = fileName(shape, i, j);
      files.push({ path: from, test: j % 50 === 0 });
      for (let k = 1; k <= 5; k += 1) {
        const to =
          k <= 3
            ? fileName(shape, i, (j + k * 7) % shape.perPackage)
            : fileName(shape, (i + k) % shape.packages, (j + k * 3) % shape.perPackage);
        edges.push({ from, to, kind: k === 5 ? 'type' : 'runtime' });
      }
    }
  }
}

function deepFiles(shape, files, edges) {
  for (let j = 0; j < shape.deep; j += 1) {
    const from = `deep/d${j}.ts`;
    files.push({ path: from, test: false });
    for (let k = 1; k <= 5; k += 1) {
      edges.push({ from, to: `deep/d${(j + k * 7) % shape.deep}.ts`, kind: k === 5 ? 'type' : 'runtime' });
    }
  }
}

function buildScan(shape) {
  const files = [];
  const edges = [];
  packageFiles(shape, files, edges);
  deepFiles(shape, files, edges);
  const workspaces = [];
  for (let i = 0; i < 8; i += 1) workspaces.push({ dir: `pkg${i}`, name: `@acme/pkg${i}` });
  return { files, edges, externals: [], workspaces };
}

function oldEdits(shape, scan) {
  const cuts = [];
  const seen = new Set();
  for (const edge of scan.edges) {
    if (!edge.from.startsWith('pkg1/') || !edge.to.startsWith('pkg1/')) continue;
    const key = `${edge.from}\n${edge.to}`;
    if (seen.has(key)) continue;
    seen.add(key);
    cuts.push({ kind: 'cut-edge', from: edge.from, to: edge.to, files: [[edge.from, edge.to]] });
    if (cuts.length === 10) break;
  }
  const moves = [];
  for (let i = 1; i <= Math.min(20, shape.perPackage / 2); i += 1) moves.push({ kind: 'move-file', file: fileName(shape, 0, i), to: '.' });
  const half = shape.packages / 2;
  const adds = [];
  for (let i = 0; i < half; i += 1) adds.push({ kind: 'add-edge', from: `pkg${i}`, to: `pkg${(i + half + 1) % shape.packages}` });
  const notes = [];
  for (let i = 0; i < 5; i += 1) notes.push({ kind: 'note', target: { node: `pkg${i + half}` }, text: `note ${i}` });
  for (let i = 0; i < 4; i += 1) notes.push({ kind: 'note', target: { edge: [`pkg${i + half}`, `pkg${(i + half + 4) % shape.packages}`] }, text: `edge ${i}` });
  const clear = edit => !JSON.stringify(edit).includes(`"${SPLIT}"`);
  return [...cuts, ...moves, ...adds.filter(clear), ...notes.filter(clear)];
}

function halves(files) {
  const half = Math.floor(files.length / 2);
  return [
    { name: 'read', files: files.slice(0, half) },
    { name: 'write', files: files.slice(half) },
  ];
}

function packageList(shape, pkg) {
  const files = [];
  for (let j = 0; j < shape.perPackage; j += 1) files.push(fileName(shape, pkg, j));
  return files;
}

function deepList(shape) {
  const files = [];
  for (let j = 0; j < shape.deep; j += 1) files.push(`deep/d${j}.ts`);
  return files;
}

function reshapeEdits(shape) {
  return [
    { kind: 'create-package', path: 'ports' },
    { kind: 'move-file', file: fileName(shape, 2, 1), to: 'ports' },
    { kind: 'rename-package', from: 'pkg3', to: 'adapters' },
    { kind: 'rename-file', from: fileName(shape, 4, 1), to: 'g1.ts' },
    { kind: 'merge-packages', packages: ['pkg5', 'pkg6'], into: 'infra' },
    { kind: 'split-package', package: SPLIT, parts: halves(packageList(shape, 7)) },
    { kind: 'split-package', package: 'deep', parts: halves(deepList(shape)) },
    { kind: 'fate', file: fileName(shape, 8, 1), fate: 'delete' },
    { kind: 'fate', file: fileName(shape, 9, 1), fate: 'fold', into: fileName(shape, 9, 2) },
    { kind: 'create-package', path: 'spare' },
  ];
}

function requireView(view, count, label) {
  if (view === null || view === undefined || view.nodes.length < count) throw new Error(`${label} did not draw`);
  return view;
}

function allFresh(reasons, label) {
  if (reasons.some(reason => reason !== null)) throw new Error(`${label} fixture is stale: ${JSON.stringify(reasons)}`);
}

function firstEdgeFrom(view, id) {
  const edge = view.edges.find(item => item.from === id && view.nodes.some(node => node.id === item.to));
  if (edge === undefined) throw new Error(`no arrow from ${id}`);
  return edge.to;
}

function importersOf(scan, file) {
  return [...new Set(scan.edges.filter(edge => edge.to === file).map(edge => edge.from))].sort();
}

function handWarnings(scan, edits) {
  return edits.map(edit => {
    if (edit.kind === 'fate' && edit.fate === 'delete') return [{ kind: 'deleted-imports', file: edit.file, importers: importersOf(scan, edit.file) }];
    if (edit.kind === 'create-package' && edit.path === 'spare') return [{ kind: 'empty-package', path: edit.path }];
    if (edit.kind === 'split-package') return [{ kind: 'added-cycle', cycle: `${edit.parts[0].name} → ${edit.parts[1].name} → ${edit.parts[0].name}` }];
    return [];
  });
}

function pictureInput(scan, planned, root, edits, stale) {
  const nowRoot = requireView(graphView(scan, '', ROOT_NAME), 20, PICTURE);
  const packages = [];
  for (const node of root.nodes) {
    if (node.kind !== 'package') continue;
    const now = graphView(scan, node.id, ROOT_NAME) ?? { error: 'no such directory' };
    const shown = graphView(planned, node.id, ROOT_NAME) ?? { error: 'no such directory' };
    packages.push({ id: node.id, now, planned: shown });
  }
  return {
    shown: 'planned',
    nodes: root.nodes,
    other: nowRoot,
    pins: {},
    edits,
    stale,
    edges: root.edges,
    ids: new Set(root.nodes.map(node => node.id)),
    packages,
    warnings: handWarnings(scan, edits),
  };
}

async function measurePicture(scan, planned, root, edits, stale) {
  if (!hasFn(pictureMod, 'planPicture')) {
    absent(PICTURE);
    return;
  }
  const input = pictureInput(scan, planned, root, edits, stale);
  const warned = input.warnings.flat().length;
  emit(
    PICTURE,
    await sample(() => {
      const picture = pictureMod.planPicture(input);
      if (picture.entries.length !== edits.length) throw new Error(`${PICTURE} dropped an entry`);
      if (picture.entries.reduce((sum, entry) => sum + entry.warnings.length, 0) !== warned) throw new Error(`${PICTURE} dropped a warning`);
      for (const edit of edits) pictureMod.entryTarget(edit);
    }, VALUES, WARMUP),
  );
}

async function measureViews(scan, edits) {
  const stale = staleReasons(scan, edits);
  allFresh(stale, APPLY);
  const planned = applyPlan(scan, edits);
  if ((planned.hidden ?? []).length === 0 || (planned.deleted ?? []).length === 0) throw new Error(`${APPLY} did not hide or delete`);

  emit(
    APPLY,
    await sample(() => {
      const next = applyPlan(scan, edits);
      if (next.files.length !== scan.files.length - 1) throw new Error(`${APPLY} lost the fold`);
    }, VALUES, WARMUP),
  );

  const root = requireView(graphView(planned, '', ROOT_NAME), 20, GRAPH_ROOT);
  for (const id of ['infra', 'adapters', 'ports', 'spare', 'pkg7/read', 'deep/read']) {
    if (!root.nodes.some(node => node.id === id)) throw new Error(`${GRAPH_ROOT} did not draw ${id}`);
  }
  emit(
    GRAPH_ROOT,
    await sample(() => {
      requireView(graphView(planned, '', ROOT_NAME), 20, GRAPH_ROOT);
    }, VALUES, WARMUP),
  );

  emit(
    GRAPH_DEEP,
    await sample(() => {
      requireView(graphView(planned, 'deep/read', ROOT_NAME), 40, GRAPH_DEEP);
    }, VALUES, WARMUP),
  );

  const fateView = requireView(graphView(planned, 'pkg8', ROOT_NAME), 150, GRAPH_FATE);
  if (!fateView.nodes.some(node => node.fate === 'delete')) throw new Error(`${GRAPH_FATE} drew no deleted file`);
  emit(
    GRAPH_FATE,
    await sample(() => {
      requireView(graphView(planned, 'pkg8', ROOT_NAME), 150, GRAPH_FATE);
    }, VALUES, WARMUP),
  );

  emit(
    DETAIL,
    await sample(() => {
      if (nodeDetail(planned, 'infra', '', ROOT_NAME) === null) throw new Error(`${DETAIL} found no infra`);
    }, VALUES, WARMUP),
  );

  const pairTo = firstEdgeFrom(root, 'infra');
  emit(
    PAIRS,
    await sample(() => {
      if (edgePairs(planned, '', 'infra', pairTo).length === 0) throw new Error(`${PAIRS} found no imports`);
    }, VALUES, WARMUP),
  );

  await measurePicture(scan, planned, root, edits, stale);
}

if (applyPlan === undefined || staleReasons === undefined || graphView === undefined || nodeDetail === undefined || edgePairs === undefined) {
  absent(...TARGETS);
} else {
  const big = buildScan(BIG);
  const edits = [...oldEdits(BIG, big), ...reshapeEdits(BIG)];
  const testTrial = staleReasons(big, edits);
  if (testTrial.some(r => r !== null)) {
    absent(...TARGETS);
  } else {
    await measureViews(big, edits);
  }
}
