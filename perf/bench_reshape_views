#!/usr/bin/env node
import {
  HEAVY_WARMUP,
  VALUES,
  WARMUP,
  absent,
  emit,
  loadExport,
  loadModule,
  sample,
} from './harness.mjs';
import { BIG, ROOT_NAME, allFresh, buildScan, oldEdits, requireView, reshapeEdits, reshapeFresh } from './reshape_fixture.mjs';

const GRAPH_ROOT = 'graphView root 4100 files reshaped';
const GRAPH_DEEP = 'graphView deep/read 50 files reshaped';
const DETAIL = 'nodeDetail root 4100 files reshaped';
const PAIRS = 'edgePairs 4100 files reshaped';
const PICTURE = 'planPicture 4100 files reshaped';

const TARGETS = [GRAPH_ROOT, GRAPH_DEEP, DETAIL, PAIRS, PICTURE];

const applyPlan = await loadExport('src/domain/planned.ts', 'applyPlan');
const staleReasons = await loadExport('src/domain/planned.ts', 'staleReasons');
const graphView = await loadExport('src/domain/graph.ts', 'graphView');
const nodeDetail = await loadExport('src/domain/graph.ts', 'nodeDetail');
const edgePairs = await loadExport('src/domain/graph.ts', 'edgePairs');
const pictureMod = await loadModule('src/ui/planpicture.ts');

function hasFn(mod, name) {
  return mod !== undefined && typeof mod[name] === 'function';
}

function firstEdgeFrom(view, id) {
  const edge = view.edges.find(item => item.from === id && view.nodes.some(node => node.id === item.to));
  if (edge === undefined) throw new Error(`no arrow from ${id}`);
  return edge.to;
}

function importersOf(scan, file) {
  return [...new Set(scan.edges.filter(edge => edge.to === file).map(edge => edge.from))].sort();
}

function handWarnings(scan, edits) {
  return edits.map(edit => {
    if (edit.kind === 'fate' && edit.fate === 'delete') return [{ kind: 'deleted-imports', file: edit.file, importers: importersOf(scan, edit.file) }];
    if (edit.kind === 'create-package' && edit.path === 'spare') return [{ kind: 'empty-package', path: edit.path }];
    if (edit.kind === 'split-package') return [{ kind: 'added-cycle', cycle: `${edit.parts[0].name} → ${edit.parts[1].name} → ${edit.parts[0].name}` }];
    return [];
  });
}

function pictureInput(scan, planned, root, edits, stale) {
  const nowRoot = requireView(graphView(scan, '', ROOT_NAME), 20, PICTURE);
  const packages = [];
  for (const node of root.nodes) {
    if (node.kind !== 'package') continue;
    const now = graphView(scan, node.id, ROOT_NAME) ?? { error: 'no such directory' };
    const shown = graphView(planned, node.id, ROOT_NAME) ?? { error: 'no such directory' };
    packages.push({ id: node.id, now, planned: shown });
  }
  return {
    shown: 'planned',
    nodes: root.nodes,
    other: nowRoot,
    pins: {},
    edits,
    stale,
    edges: root.edges,
    ids: new Set(root.nodes.map(node => node.id)),
    packages,
    warnings: handWarnings(scan, edits),
  };
}

async function measurePicture(scan, planned, root, edits, stale) {
  if (!hasFn(pictureMod, 'planPicture')) {
    absent(PICTURE);
    return;
  }
  const input = pictureInput(scan, planned, root, edits, stale);
  const warned = input.warnings.flat().length;
  emit(
    PICTURE,
    await sample(() => {
      const picture = pictureMod.planPicture(input);
      if (picture.entries.length !== edits.length) throw new Error(`${PICTURE} dropped an entry`);
      if (picture.entries.reduce((sum, entry) => sum + entry.warnings.length, 0) !== warned) throw new Error(`${PICTURE} dropped a warning`);
      for (const edit of edits) pictureMod.entryTarget(edit);
    }, VALUES, WARMUP),
  );
}

async function measureViews(scan, edits) {
  const stale = staleReasons(scan, edits);
  allFresh(stale, GRAPH_ROOT);
  const planned = applyPlan(scan, edits);

  const root = requireView(graphView(planned, '', ROOT_NAME), 20, GRAPH_ROOT);
  for (const id of ['infra', 'adapters', 'ports', 'spare', 'pkg7/read', 'deep/read']) {
    if (!root.nodes.some(node => node.id === id)) throw new Error(`${GRAPH_ROOT} did not draw ${id}`);
  }
  emit(
    GRAPH_ROOT,
    await sample(() => {
      requireView(graphView(planned, '', ROOT_NAME), 20, GRAPH_ROOT);
    }, VALUES, HEAVY_WARMUP),
  );

  emit(
    GRAPH_DEEP,
    await sample(() => {
      requireView(graphView(planned, 'deep/read', ROOT_NAME), 40, GRAPH_DEEP);
    }, VALUES, WARMUP),
  );

  emit(
    DETAIL,
    await sample(() => {
      if (nodeDetail(planned, 'infra', '', ROOT_NAME) === null) throw new Error(`${DETAIL} found no infra`);
    }, VALUES, HEAVY_WARMUP),
  );

  const pairTo = firstEdgeFrom(root, 'infra');
  emit(
    PAIRS,
    await sample(() => {
      if (edgePairs(planned, '', 'infra', pairTo).length === 0) throw new Error(`${PAIRS} found no imports`);
    }, VALUES, WARMUP),
  );

  await measurePicture(scan, planned, root, edits, stale);
}

const big = buildScan(BIG);
const edits = [...oldEdits(BIG, big), ...reshapeEdits(BIG)];
if (applyPlan === undefined || staleReasons === undefined || graphView === undefined || nodeDetail === undefined || edgePairs === undefined || !reshapeFresh(staleReasons, big, edits)) {
  absent(...TARGETS);
} else {
  await measureViews(big, edits);
}
